<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Charity Map</title>
    <style>
        #map {
            height: 100%;
            width: 100%;
        }
        body, html {
            margin: 0;
            height: 100%;
        }
    </style>
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY&callback=initMap" async defer></script>
</head>
<body>
    <div id="map"></div>

    <script>
        function initMap() {
            var mapOptions = {
                zoom: 5,
                center: {lat: 20.5937, lng: 78.9629},  // Central point of India
                mapTypeId: 'roadmap'
            };

            var map = new google.maps.Map(document.getElementById('map'), mapOptions);

            // Charity locations - replace these with real data
            var charities = [
                {
                    title: "PFA Trivandrum",
                    lat: 8.5236,  // Latitude for PFA Trivandrum
                    lng: 76.9366, // Longitude for PFA Trivandrum
                    link: "https://www.pfatv.com"  // Replace with actual website
                }
                // Add more charity locations as needed
            ];

            // Add markers to the map
            charities.forEach(function(charity) {
                var marker = new google.maps.Marker({
                    position: {lat: charity.lat, lng: charity.lng},
                    map: map,
                    title: charity.title,
                    icon: {
                        url: "https://maps.google.com/mapfiles/kml/paddle/grn-circle.png",  // Green circle icon
                        scaledSize: new google.maps.Size(40, 40)
                    }
                });

                // Add info window on marker click
                var infoWindow = new google.maps.InfoWindow({
                    content: `<div><strong>${charity.title}</strong><br><a href="${charity.link}" target="_blank">Visit Website</a></div>`
                });

                marker.addListener('click', function() {
                    infoWindow.open(map, marker);
                });
            });
        }
    </script>
</body>
</html>
